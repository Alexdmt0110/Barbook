generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceKind {
  PERSONAL
  SHARED
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum BarAccent {
  AMBER
  RED
  TEAL
  BLUE
}

enum StockMovementKind {
  INITIAL
  ADD
  REMOVE
  SET
}

enum CocktailType {
  CLASSIC
  PERSONAL_CREATION
  VARIATION
}

enum RecipeMethod {
  SHAKER
  MIXING_GLASS
  BUILD
  BLENDER
}

enum MeasurementUnit {
  ML
  G
  PIECE
  LEAF
  SPRIG
  DASH
  DROP
  BAR_SPOON
  TEASPOON
  TABLESPOON
  SCOOP
  PINCH
  TOP_UP
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  displayName  String

  personalWorkspace Workspace?        @relation("PersonalWorkspaceOwner")
  memberships       WorkspaceMember[]
  sessions          Session[]
  createdBars       Workspace[] @relation("WorkspaceCreator")
  stockMovements    StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String @id @default(uuid())
  userId    String
  tokenHash String @unique @db.VarChar(64)
  csrfToken String @db.VarChar(43)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  persistent    Boolean   @default(false)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt    DateTime  @db.Timestamptz(3)
  idleExpiresAt DateTime  @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@index([idleExpiresAt])
}

model Workspace {
  id              String        @id @default(uuid())
  name            String
  kind            WorkspaceKind
  personalOwnerId String?       @unique
  accessVersion   Int           @default(0)
  accentKey       BarAccent?
  creationActorId String?
  creationRequestId String? @db.Uuid
  creationFingerprint String? @db.Char(64)

  creationActor User? @relation("WorkspaceCreator", fields: [creationActorId], references: [id], onDelete: Restrict)


  personalOwner User? @relation("PersonalWorkspaceOwner", fields: [personalOwnerId], references: [id], onDelete: Cascade)

  members     WorkspaceMember[]
  cocktails   Cocktail[]
  ingredients Ingredient[]
  tags        Tag[]
  folders     Folder[]
  stockProducts StockProduct[]
  stockMovements StockMovement[]

  @@unique([creationActorId, creationRequestId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())
  revokedAt DateTime? @db.Timestamptz(3)

  @@id([workspaceId, userId])
  @@index([userId])
}

model Folder {
  id          String @id @default(uuid())
  name        String
  workspaceId String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /**
   * Relation historique temporairement conservée pendant
   * la migration expand/contract.
   */
  cocktails Cocktail[]

  memberships CocktailFolder[]

  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
}

model Cocktail {
  id   String @id @default(uuid())
  slug String
  name String

  type   CocktailType
  family String?
  method RecipeMethod

  glass    String
  ice      String?
  notes    String?
  imageUrl String?

  workspaceId   String
  folderId      String?
  mainAlcoholId String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /**
   * Relation historique temporairement conservée pendant
   * la migration expand/contract.
   */
  folder Folder? @relation(fields: [workspaceId, folderId], references: [workspaceId, id], onDelete: Restrict)

  mainAlcohol Ingredient? @relation("CocktailMainAlcohol", fields: [workspaceId, mainAlcoholId], references: [workspaceId, id], onDelete: Restrict)

  ingredients       CocktailIngredient[]
  garnishes         GarnishIngredient[]
  steps             PreparationStep[]
  tags              CocktailTag[]
  folderMemberships CocktailFolder[]

  organizationVersion Int       @default(0)
  contentVersion      Int       @default(0)
  deletedAt           DateTime? @db.Timestamptz(3)
  restoreUntil        DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, slug])
  @@index([folderId])
  @@index([mainAlcoholId])
  @@index([workspaceId, name])
  @@index([workspaceId, type])
  @@index([workspaceId, mainAlcoholId])
  @@index([workspaceId, method])
  @@index([workspaceId, deletedAt])
}

model CocktailFolder {
  workspaceId String
  cocktailId  String
  folderId    String

  cocktail Cocktail @relation(fields: [workspaceId, cocktailId], references: [workspaceId, id], onDelete: Cascade)
  folder   Folder   @relation(fields: [workspaceId, folderId], references: [workspaceId, id], onDelete: Cascade)

  @@id([cocktailId, folderId])
  @@index([workspaceId, folderId])
}

model Ingredient {
  id          String   @id @default(uuid())
  name        String
  slug        String
  defaultAbv  Decimal? @db.Decimal(5, 2)
  workspaceId String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  cocktailRelations CocktailIngredient[]
  garnishRelations  GarnishIngredient[]
  mainAlcoholFor    Cocktail[]           @relation("CocktailMainAlcohol")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, slug])
}

model CocktailIngredient {
  id           String @id @default(uuid())
  workspaceId  String
  cocktailId   String
  ingredientId String

  amount        Decimal?        @db.Decimal(8, 3)
  unit          MeasurementUnit
  specification String?
  abvOverride   Decimal?        @db.Decimal(5, 2)
  abvUnknown    Boolean         @default(false)
  notes         String?
  sortOrder     Int

  cocktail   Cocktail   @relation(fields: [workspaceId, cocktailId], references: [workspaceId, id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [workspaceId, ingredientId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([cocktailId, ingredientId])
  @@unique([cocktailId, sortOrder])
  @@index([ingredientId])
}

model GarnishIngredient {
  id           String @id @default(uuid())
  workspaceId  String
  cocktailId   String
  ingredientId String

  amount        Decimal?         @db.Decimal(8, 3)
  unit          MeasurementUnit?
  specification String?
  usage         String
  sortOrder     Int

  cocktail   Cocktail   @relation(fields: [workspaceId, cocktailId], references: [workspaceId, id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [workspaceId, ingredientId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([cocktailId, sortOrder])
  @@index([ingredientId])
}

model PreparationStep {
  id         String @id @default(uuid())
  cocktailId String
  content    String
  sortOrder  Int

  cocktail Cocktail @relation(fields: [cocktailId], references: [id], onDelete: Cascade)

  @@unique([cocktailId, sortOrder])
}

model Tag {
  id          String @id @default(uuid())
  name        String
  slug        String
  workspaceId String

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cocktails CocktailTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, slug])
}

model CocktailTag {
  workspaceId String
  cocktailId  String
  tagId       String

  cocktail Cocktail @relation(fields: [workspaceId, cocktailId], references: [workspaceId, id], onDelete: Cascade)
  tag      Tag      @relation(fields: [workspaceId, tagId], references: [workspaceId, id], onDelete: Cascade)

  @@id([cocktailId, tagId])
  @@index([tagId])
}

// Physical units only. No relationship to recipe ingredients or batch calculations.
model StockProduct {
  id String @id @default(uuid())
  workspaceId String
  name String @db.VarChar(80)
  packaging String @db.VarChar(120)
  quantity Int
  threshold Int
  target Int
  version Int @default(0)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  movements StockMovement[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([workspaceId, id])
  @@index([workspaceId, name, id])
}

model StockMovement {
  id String @id @default(uuid())
  workspaceId String
  productId String
  actorId String
  requestId String @db.Uuid
  fingerprint String @db.Char(64)
  kind StockMovementKind
  beforeQuantity Int
  afterQuantity Int
  delta Int
  reason String @db.VarChar(240)
  productVersion Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  product StockProduct @relation(fields: [workspaceId, productId], references: [workspaceId, id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([actorId, requestId])
  @@unique([productId, productVersion])
  @@index([workspaceId, productId, productVersion])
}
